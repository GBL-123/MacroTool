@implements IDisposable
@inject MacroEngine Engine
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<header class="topbar">
    <div class="bar-inner">
        <a class="brand" href="/">
            <span class="brand-mark">M</span>
            <span class="brand-text">
                <span class="brand-name">MacroTool</span>
                <span class="brand-sub">local console</span>
            </span>
        </a>

        <nav class="nav-tabs">
            <NavLink class="nav-tab" ActiveClass="active" href="/" Match="NavLinkMatch.All">概览</NavLink>
            <NavLink class="nav-tab" ActiveClass="active" href="/timeline" Match="NavLinkMatch.Prefix">时间线</NavLink>
            <NavLink class="nav-tab" ActiveClass="active" href="/logs" Match="NavLinkMatch.Prefix">日志</NavLink>
        </nav>

        <span class="bar-sep" aria-hidden="true"></span>

        <EngineStatusChip />

        <div class="bar-metrics">
            @if (_snapshot.State == ToolState.Recording)
            {
                <span class="bar-metric"><span class="bar-metric-label">点击</span>@_snapshot.ClickCount</span>
                <span class="bar-metric"><span class="bar-metric-label">按键</span>@_snapshot.KeyCount</span>
                <span class="bar-metric"><span class="bar-metric-label">已录</span>@FormatMs(_snapshot.RecordingElapsedMs)</span>
            }
            else if (_snapshot.State == ToolState.Playing)
            {
                string roundSuffix = _snapshot.PlaybackRepeat > 0 ? " / " + _snapshot.PlaybackRepeat : "";
                <span class="bar-metric"><span class="bar-metric-label">轮数</span>@($"{_snapshot.PlaybackRound}{roundSuffix}")</span>
                <span class="bar-metric"><span class="bar-metric-label">已播</span>@FormatMs(_snapshot.PlaybackElapsedMs)</span>
            }
            else
            {
                <span class="bar-metric"><span class="bar-metric-label">事件</span>@_snapshot.EventCount</span>
                <span class="bar-metric"><span class="bar-metric-label">时长</span>@FormatMs(_snapshot.DurationMs)</span>
            }
        </div>

        <span class="bar-sep" aria-hidden="true"></span>

        <div class="transport">
            @if (_snapshot.State == ToolState.Recording)
            {
                <MudButton Class="btn-tonal-danger" Size="Size.Small" StartIcon="@Icons.Material.Filled.Stop"
                           OnClick="StopRecording">停止录制</MudButton>
            }
            else
            {
                <MudButton Class="btn-tonal-danger" Size="Size.Small" StartIcon="@Icons.Material.Filled.FiberManualRecord"
                           OnClick="StartRecording" Disabled="@(_snapshot.State == ToolState.Playing)">录制</MudButton>
            }

            @if (_snapshot.State == ToolState.Playing)
            {
                <MudButton Class="btn-tonal-ok" Size="Size.Small" StartIcon="@Icons.Material.Filled.Stop"
                           OnClick="StopPlayback">停止回放</MudButton>
            }
            else
            {
                <MudButton Class="btn-tonal-ok" Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="StartPlayback" Disabled="@(!_snapshot.HasTimeline || _snapshot.State == ToolState.Recording)">回放</MudButton>
            }

            <MudButton Class="btn-tonal-neutral" Size="Size.Small" StartIcon="@Icons.Material.Filled.StopCircle"
                       OnClick="StopAll" Disabled="@(_snapshot.State == ToolState.Idle)">停止</MudButton>
        </div>

        <span class="bar-sep" aria-hidden="true"></span>

        <div class="bar-params">
            <div class="bar-field bar-field--speed">
                <span class="micro-label">倍速</span>
                <MudSelect T="double" @bind-Value="_speed" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                    @foreach (var option in SpeedOptions)
                    {
                        <MudSelectItem T="double" Value="@option">@($"{option:0.0}×")</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="bar-field">
                <span class="micro-label">抖动 (px)</span>
                <MudTextField T="string" Value="_jitterText" ValueChanged="OnJitterTextChanged" Error="_jitterInvalid"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <div class="bar-field">
                <span class="micro-label">回放次数</span>
                <MudTextField T="string" Value="_repeatCountText" ValueChanged="OnRepeatCountTextChanged" Error="_repeatCountInvalid"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
            </div>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="Apply">应用</MudButton>
        </div>

        <span class="topbar-spacer"></span>

        <MudIconButton Icon="@Icons.Material.Filled.PowerSettingsNew" Color="Color.Inherit"
                       OnClick="Shutdown" title="关闭服务" Size="Size.Small" />
    </div>
</header>

@if (_snapshot.State == ToolState.Recording)
{
    <div class="banner-recording banner-in-frame">
        <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
        录制中：请勿点击本页面（包括停止按钮），页面上的点击会被录入时间线。建议用 F10 停止录制。
    </div>
}

@code {
    internal static readonly double[] SpeedChoices =
        Enumerable.Range(1, 30).Select(i => i / 10.0).ToArray();

    private EngineSnapshot _snapshot;
    private double _speed;
    private string _jitterText = "";
    private string _repeatCountText = "";
    private bool _jitterInvalid;
    private bool _repeatCountInvalid;
    private System.Threading.Timer? _timer;
    private bool _subscribed;
    private bool _disposed;

    private IEnumerable<double> SpeedOptions =>
        SpeedChoices.Contains(_speed) ? SpeedChoices : SpeedChoices.Append(_speed).OrderBy(v => v);

    protected override void OnInitialized()
    {
        _snapshot = Engine.GetSnapshot();
        _speed = _snapshot.Speed;
        _jitterText = _snapshot.Jitter.ToString();
        _repeatCountText = _snapshot.RepeatCount == 0 ? "" : _snapshot.RepeatCount.ToString();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _subscribed) return;
        _subscribed = true;
        Engine.StateChanged += OnEngineChanged;
        Engine.TimelineChanged += OnEngineChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            if (_disposed) return;
            InvokeAsync(() =>
            {
                if (_disposed) return;
                _snapshot = Engine.GetSnapshot();
                StateHasChanged();
            });
        }, null, 500, 500);
    }

    private void OnEngineChanged()
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            _snapshot = Engine.GetSnapshot();
            StateHasChanged();
        });
    }

    private async Task StartRecording() => await Task.Run(Engine.StartRecording);

    private async Task StopRecording() => await Task.Run(() => Engine.StopRecording(fromUi: true));

    private async Task StartPlayback() => await Task.Run(Engine.StartPlayback);

    private async Task StopPlayback() => await Task.Run(Engine.StopPlayback);

    private async Task StopAll() => await Task.Run(() => Engine.StopAll(fromUi: true));

    private void OnJitterTextChanged(string? text)
    {
        _jitterText = text ?? "";
        _jitterInvalid = false;
    }

    private void OnRepeatCountTextChanged(string? text)
    {
        _repeatCountText = text ?? "";
        _repeatCountInvalid = false;
    }

    private void Apply()
    {
        if (!TryParseInt(_jitterText, min: 0, max: 100, out int jitter))
        {
            _jitterInvalid = true;
            Snackbar.Add("抖动需为 0 到 100 之间的整数", Severity.Error);
            return;
        }

        int repeatCount;
        if (string.IsNullOrWhiteSpace(_repeatCountText))
            repeatCount = 0;
        else if (!TryParseInt(_repeatCountText, min: 0, max: 9999, out repeatCount))
        {
            _repeatCountInvalid = true;
            Snackbar.Add("回放次数需为 0 到 9999 之间的整数", Severity.Error);
            return;
        }

        if (Engine.UpdateSettings(_speed, jitter, repeatCount, out var error))
            Snackbar.Add("参数已更新", Severity.Success);
        else
            Snackbar.Add(error ?? "参数无效", Severity.Error);
    }

    internal static bool TryParseInt(string? text, int min, int max, out int value)
    {
        value = 0;
        if (text is null)
            return false;

        var normalized = new System.Text.StringBuilder(text.Length);
        foreach (char c in text.Trim())
            normalized.Append(c is >= '\uFF10' and <= '\uFF19' ? (char)(c - '\uFF10' + '0') : c);

        if (!int.TryParse(normalized.ToString(), out int parsed))
            return false;
        if (parsed < min || parsed > max)
            return false;

        value = parsed;
        return true;
    }

    private async Task Shutdown()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "关闭服务",
            "确认关闭 MacroTool 服务？正在进行的录制会先保存。",
            yesText: "关闭",
            cancelText: "取消");

        if (confirmed == true)
            Engine.RequestShutdown(fromUi: true);
    }

    private static string FormatMs(double ms) => TimeSpan.FromMilliseconds(Math.Max(0, ms)).ToString(@"m\:ss\.fff");

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        if (_subscribed)
        {
            Engine.StateChanged -= OnEngineChanged;
            Engine.TimelineChanged -= OnEngineChanged;
        }
    }
}
