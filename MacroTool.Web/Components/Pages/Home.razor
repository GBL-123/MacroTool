@page "/"
@implements IDisposable
@inject MacroEngine Engine

<PageTitle>概览 - MacroTool</PageTitle>

<div class="dash-grid">
    <section class="panel col-6 panel-column">
        <div class="panel-head">
            <h2 class="panel-title">当前会话</h2>
            <span class="panel-head-spacer"></span>
            <span class="panel-head-meta">@StatusHint()</span>
        </div>

        <div class="status-inline">
            <span class="status-dot @StatusDotClass()"></span>
            <span class="status-inline-label">@StatusLabel()</span>
        </div>

        <div class="metrics metrics--flush">
            @if (_snapshot.State == ToolState.Recording)
            {
                <Metric Label="点击" Value="@_snapshot.ClickCount.ToString()" />
                <Metric Label="按键" Value="@_snapshot.KeyCount.ToString()" />
                <Metric Label="已录" Value="@FormatMs(_snapshot.RecordingElapsedMs)" />
            }
            else if (_snapshot.State == ToolState.Playing)
            {
                <Metric Label="完成轮数" Value="@_snapshot.PlaybackRound.ToString()" />
                <Metric Label="已播" Value="@FormatMs(_snapshot.PlaybackElapsedMs)" />
            }
            else
            {
                <Metric Label="事件" Value="@_snapshot.EventCount.ToString()" />
                <Metric Label="总时长" Value="@FormatMs(_snapshot.DurationMs)" />
            }
        </div>
    </section>

    <section class="panel col-6">
        <div class="panel-head">
            <h2 class="panel-title">时间线</h2>
            <span class="panel-head-spacer"></span>
            @if (_snapshot.HasTimeline)
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Edit" Href="/timeline">编辑</MudButton>
            }
        </div>

        @if (_snapshot.HasTimeline)
        {
            <div class="kv">
                <div class="kv-row">
                    <span class="kv-key">事件</span>
                    <span class="kv-val">@_snapshot.EventCount</span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">总时长</span>
                    <span class="kv-val">@FormatMs(_snapshot.DurationMs)</span>
                </div>
                <div class="kv-row">
                    <span class="kv-key">文件</span>
                    <span class="kv-val">@Engine.TimelinePath</span>
                </div>
            </div>
        }
        else
        {
            <p class="notice is-info">尚无时间线，按 F10 或在控制条点"录制"。</p>
        }
    </section>

    <div class="col-12">
        <EnvHints />
    </div>
</div>

@code {
    private EngineSnapshot _snapshot;
    private System.Threading.Timer? _timer;
    private bool _subscribed;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _snapshot = Engine.GetSnapshot();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _subscribed) return;
        _subscribed = true;
        Engine.StateChanged += OnEngineChanged;
        Engine.TimelineChanged += OnEngineChanged;
        _timer = new System.Threading.Timer(_ =>
        {
            if (_disposed) return;
            InvokeAsync(() =>
            {
                if (_disposed) return;
                _snapshot = Engine.GetSnapshot();
                StateHasChanged();
            });
        }, null, 500, 500);
    }

    private void OnEngineChanged()
    {
        if (_disposed) return;
        InvokeAsync(() =>
        {
            _snapshot = Engine.GetSnapshot();
            StateHasChanged();
        });
    }

    private string StatusLabel() => _snapshot.State switch
    {
        ToolState.Recording => "录制中",
        ToolState.Playing => "回放中",
        _ => "空闲"
    };

    private string StatusDotClass() => _snapshot.State switch
    {
        ToolState.Recording => "is-recording",
        ToolState.Playing => "is-playing",
        _ => "is-idle"
    };

    private string StatusHint() => _snapshot.State switch
    {
        ToolState.Recording => "操作原样透传；用 F10 或控制条停止",
        ToolState.Playing => "按 F11 或控制条停止；参数改动下一轮生效",
        _ => _snapshot.HasTimeline ? "按 F10 开始录制，F11 循环回放" : "按 F10 或控制条「录制」开始"
    };

    private static string FormatMs(double ms) => TimeSpan.FromMilliseconds(Math.Max(0, ms)).ToString(@"m\:ss\.fff");

    public void Dispose()
    {
        _disposed = true;
        _timer?.Dispose();
        if (_subscribed)
        {
            Engine.StateChanged -= OnEngineChanged;
            Engine.TimelineChanged -= OnEngineChanged;
        }
    }
}
